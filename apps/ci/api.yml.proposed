# PROPOSED by Agent 3. Needs a PostgreSQL service (tests run real migrations and real queries).
name: apps-api
on:
  pull_request:
    paths: ["apps/api/**", "contracts/python/**", "docs/API_CONTRACTS.md"]
jobs:
  api:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16
        env: { POSTGRES_USER: gridora, POSTGRES_PASSWORD: gridora, POSTGRES_DB: gridora_test }
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U gridora" --health-interval 5s --health-timeout 5s --health-retries 10
    env:
      GRIDORA_TEST_DATABASE_URL: postgresql+asyncpg://gridora:gridora@localhost:5432/gridora_test
    defaults: { run: { working-directory: apps/api } }
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: "3.12", cache: pip }
      - run: pip install -e ../../contracts/python -e ".[dev]" psycopg2-binary
      - run: ruff check .
      - run: mypy src
      - run: pytest -q
