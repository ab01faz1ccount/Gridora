# Copy to .env and edit. Never commit .env.

# --- required ---------------------------------------------------------------
# Used inside a URL: use only letters and digits (or percent-encode special characters).
POSTGRES_PASSWORD=CHANGE_ME_letters_and_digits_only

# --- first start only -------------------------------------------------------
# Creates the first admin when there are no users. REMOVE both lines after the first start.
GRIDORA_BOOTSTRAP_ADMIN_USERNAME=admin
GRIDORA_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_at_least_10_characters

# --- engine implementations -------------------------------------------------
# "stub" = in-memory, CSV only, formulas NOT evaluated (the only one that works today).
GRIDORA_ENGINE=stub
GRIDORA_DATAOPS=stub

# --- ports (published by nginx) ---------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443

# --- backups ----------------------------------------------------------------
BACKUP_AT=02:30
BACKUP_KEEP_DAYS=14
